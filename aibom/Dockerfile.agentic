#
# Multi-stage Dockerfile for cisco-aibom CLI — full variant.
# Includes ALL extras: analysis, security, agentic, cloud.
# Larger image (~800MB) due to LLM and cloud SDK dependencies.

# ---------- Stage 1: Build ----------
FROM python:3.12-slim AS builder

RUN pip install --no-cache-dir uv

WORKDIR /build
COPY pyproject.toml README.md ./
COPY src/ ./src/

RUN uv pip install --system --no-cache ".[all]"

# ---------- Stage 2: Runtime ----------
FROM python:3.12-slim AS runtime

LABEL org.opencontainers.image.title="cisco-aibom-agentic" \
      org.opencontainers.image.description="AI Bill of Materials CLI — full variant with agentic enrichment and cloud scanning" \
      org.opencontainers.image.source="https://github.com/cisco-ai-defense/aibom" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.vendor="Cisco Systems, Inc."

COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin/cisco-aibom /usr/local/bin/cisco-aibom

WORKDIR /workspace

ENTRYPOINT ["cisco-aibom"]
CMD ["--help"]
